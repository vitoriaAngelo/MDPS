<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MDPS</AssemblyName>
    <ApplicationIcon>Assets/mdps.ico</ApplicationIcon>
    <Version>1.2.5</Version>
    <Authors>@misttylol</Authors>
    <Company>@misttylol</Company>
    <Description>Leitor de DPS e cura da PT para AION 2 Global, criado por @misttylol.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../vendor/AionMeter.Core/AionMeter.Core.csproj" />
    <Resource Include="Assets/Classes/*.png" />
    <Resource Include="Assets/mdps.ico" />
    <Content Include="../../data/**/*" Link="data/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../CREDITOS.md" Link="CREDITOS.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
